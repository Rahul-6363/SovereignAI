# ─────────────────────────────────────────────────────────────
# Meshcore — environment template
#
# Copy to `.env` and adjust. `.env` is gitignored: it is per-machine
# config, and hardware differs across the team.
#
#     cp .env.example .env
#
# Nothing here is a secret. Meshcore is air-gapped by design — there are
# no API keys, and ENABLE_EXTERNAL_NETWORK=false is enforced by a tripwire
# that counts (and blocks) any attempted egress.
# ─────────────────────────────────────────────────────────────

# ── Ollama gateway ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# DEFAULT PRESET — 16 GB RAM / Core i5, CPU-only. ~2.8 GB of downloads.
#   make models-small
OLLAMA_CHAT_MODEL=gemma3:1b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# BETTER PRESET — 32 GB RAM or a GPU. Noticeably better prose; the small
# chat model paraphrases loosely and will mislabel a line as an instrument.
#   make models
# OLLAMA_CHAT_MODEL=qwen3:4b
# OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Generation caps. Keeps a small model from rambling; structured output
# (spreadsheet/document drafting) overrides this internally.
OLLAMA_NUM_PREDICT=320
VISION_NUM_PREDICT=2048

# Escalation targets — dormant while ENABLE_MODEL_ESCALATION=false.
VISION_FALLBACK_MODEL=qwen2.5vl:3b
REASONING_FALLBACK_MODEL=qwen3:4b

# ── Storage (paths are relative to the repo root) ────────────
DATABASE_URL=sqlite:///./data/plant_memory.db
UPLOAD_DIR=./data/uploads
PAGE_DIR=./data/pages
INDEX_DIR=./data/indexes

# ── Routing / trust ──────────────────────────────────────────
ENABLE_MODEL_ESCALATION=false
ENABLE_AUDIT_LOG=true
# Leave false. `make verify` asserts it, and the Trust panel's egress
# counter must read 0 for the local-only claim to hold.
ENABLE_EXTERNAL_NETWORK=false

# FORCE_OFFLINE_EXTRACTION
#   true  → deterministic golden extraction for the bundled demo sheets:
#           instant and exact, which is the right default for a demo.
#   false → real extraction (vector → OCR → vision) on whatever is uploaded.
FORCE_OFFLINE_EXTRACTION=false

# ── OCR engine (optional) ────────────────────────────────────
# Unset, the pipeline prefers PaddleOCR when installed and falls back to
# RapidOCR. Force one with paddleocr | rapidocr; a broken explicit choice
# still falls back rather than dropping the sheet to the vision model.
#   make ocr-paddle   install PaddleOCR (~700 MB, better on small text)
#   make ocr-which    show which engine will actually run
# MESHCORE_OCR_ENGINE=paddleocr
